# ── Supabase Project ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://zmujrcvwyyilmlbtycxc.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_br78PwbhLUTq7B8e8XhVig_YD63TnEJ"

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.zmujrcvwyyilmlbtycxc:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.zmujrcvwyyilmlbtycxc:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET="change-this-in-production-use-long-random-string-min-64-chars"
JWT_EXPIRY="7d"

# ── Storage (MinIO / S3-compatible) ───────────────────────────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="myprint_minio"
S3_SECRET_KEY="myprint_minio_secret"
S3_BUCKET="myprint-documents"

# ── Application ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Payment (Razorpay) ────────────────────────────────────────────────────────
PAYMENT_MODE="mock"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ── Redis (optional) ─────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
