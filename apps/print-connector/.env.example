# MyPrint Local Print Connector — Configuration
# Copy this file to .env and fill in your values

# Backend URL (where the Next.js app is running)
BACKEND_URL=http://localhost:3000

# Your shop credentials (get these from the dashboard)
SHOP_ID=your-shop-id-here
SHOP_EMAIL=your-email@example.com
SHOP_PASSWORD=your-password-here

# Connector identity (auto-generated on first run — do not change after setup)
CONNECTOR_ID=

# Polling interval in seconds (how often to check for new jobs)
POLL_INTERVAL_SECONDS=5

# Maximum retry attempts per job before marking as failed
MAX_RETRY_ATTEMPTS=3

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Temporary folder for downloaded documents (deleted after printing)
TEMP_DIR=./temp_docs

# Optional: Override automatic printer detection with a specific printer name
# DEFAULT_PRINTER=HP LaserJet Pro M404n

